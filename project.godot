; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pedestrian Pursuit"
config/description="Original arcade foot racing across the four-course Sole Surge Cup"
config/version="0.4.0-digital-rc"
run/main_scene="res://scenes/main/MainMenu.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

ProgressionSave="*res://scripts/core/ProgressionSave.gd"
AchievementRuntime="*res://scripts/core/AchievementRuntime.gd"
AchievementToast="*res://scripts/ui/AchievementToast.gd"
GameManager="*res://scripts/core/GameManager.gd"
InputManager="*res://scripts/core/InputManager.gd"
SceneLoader="*res://scripts/core/SceneLoader.gd"
DeviceRoleRuntime="*res://scripts/core/DeviceRoleRuntime.gd"
DockDisplayHook="*res://scripts/core/DockDisplayHook.gd"
AccessibilitySettings="*res://scripts/core/AccessibilitySettings.gd"
TelemetryBus="*res://scripts/core/TelemetryBus.gd"
AudioDirector="*res://scripts/audio/AudioDirector.gd"
ProductionGateHarness="*res://scripts/rc/ProductionGateHarness.gd"
CrossDeviceContractRunner="*res://scripts/cross_device/cross_device_contract_runner.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

