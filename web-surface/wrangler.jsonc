{
  "name": "pedestrian-pursuit-web",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "RUNTIME",
      "bucket_name": "gunnchos-game-runtimes-staging"
    }
  ]
}
